{
  "schemaVersion": 2,
  "services": [
    {
      "name": "calagopus-heavy-aio",
      "image": "ghcr.io/calagopus/panel:heavy-aio",
      "isMain": true,
      "internalPort": 8000,
      "restart": "unless-stopped",
      "stopGracePeriod": "40s",
      "environment": [
        { "key": "TZ", "value": "${TZ}" },
        { "key": "PORT", "value": "8000" },
        { "key": "REDIS_URL", "value": "redis://calagopus-heavy-aio-cache" },
        { "key": "DATABASE_URL", "value": "postgresql://panel:panel@calagopus-heavy-aio-db/panel" },
        { "key": "DATABASE_MIGRATE", "value": "true" },
        { "key": "AIO_BASE_WINGS_CONFIGURATION", "value": "/config/wings-config.yml" },
        { "key": "APP_DEBUG", "value": "false" },
        { "key": "APP_LOG_DIRECTORY", "value": "/var/log/calagopus" },
        { "key": "APP_PRIMARY", "value": "true" },
        { "key": "APP_ENABLE_WINGS_PROXY", "value": "true" },
        { "key": "APP_ENCRYPTION_KEY", "value": "${CALAGOPUS_ENCRYPTION_KEY}" },
        { "key": "APP_USE_DECRYPTION_CACHE", "value": "true" },
        { "key": "APP_USE_INTERNAL_CACHE", "value": "true" }
      ],
      "dns": ["1.1.1.1", "8.8.8.8", "9.9.9.9"],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/calagopus", "containerPath": "/var/lib/calagopus" },
        { "hostPath": "${APP_DATA_DIR}/data/logs", "containerPath": "/var/log/calagopus" },
        { "hostPath": "${APP_DATA_DIR}/data/build/binaries", "containerPath": "/app/binaries" },
        { "hostPath": "${APP_DATA_DIR}/data/build/translations", "containerPath": "/app/translations" },
        { "hostPath": "${APP_DATA_DIR}/data/build/extensions", "containerPath": "/app/extensions" },
        { "hostPath": "${APP_DATA_DIR}/data/build/extension-migrations", "containerPath": "/app/repo/database/extension-migrations" },
        { "hostPath": "${APP_DATA_DIR}/data/config", "containerPath": "/config" },
        { "hostPath": "/var/run/docker.sock", "containerPath": "/var/run/docker.sock" },
        { "hostPath": "/var/lib/docker/containers/", "containerPath": "/var/lib/docker/containers/" },
        { "hostPath": "${APP_DATA_DIR}/data/wings/etc", "containerPath": "${APP_DATA_DIR}/data/wings/etc" },
        { "hostPath": "${APP_DATA_DIR}/data/wings/lib", "containerPath": "${APP_DATA_DIR}/data/wings/lib" },
        { "hostPath": "${APP_DATA_DIR}/data/wings/log", "containerPath": "${APP_DATA_DIR}/data/wings/log" },
        { "hostPath": "${APP_DATA_DIR}/data/wings/tmp", "containerPath": "${APP_DATA_DIR}/data/wings/tmp" }
      ],
      "addPorts": [
        { "hostPort": 2022, "containerPort": 2022 }
      ],
      "extraHosts": ["host.docker.internal:host-gateway"],
      "dependsOn": ["calagopus-heavy-aio-db", "calagopus-heavy-aio-cache"]
    },
    {
      "name": "calagopus-heavy-aio-db",
      "image": "ghcr.io/calagopus/pgautoupgrade:18-alpine",
      "restart": "unless-stopped",
      "environment": [
        { "key": "TZ", "value": "${TZ}" },
        { "key": "POSTGRES_USER", "value": "panel" },
        { "key": "POSTGRES_PASSWORD", "value": "panel" },
        { "key": "POSTGRES_DB", "value": "panel" },
        { "key": "PGDATA", "value": "/data" }
      ],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/postgres", "containerPath": "/data" }
      ]
    },
    {
      "name": "calagopus-heavy-aio-cache",
      "image": "ghcr.io/calagopus/valkey:latest",
      "restart": "unless-stopped",
      "command": "--protected-mode no --save 60 1",
      "environment": [
        { "key": "TZ", "value": "${TZ}" }
      ],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/cache", "containerPath": "/data" }
      ]
    }
  ]
}
