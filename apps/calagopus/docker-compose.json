{
  "schemaVersion": 2,
  "services": [
    {
      "name": "web",
      "image": "ghcr.io/calagopus/panel:latest",
      "isMain": true,
      "internalPort": 8000,
      "restart": "unless-stopped",
      "environment": [
        { "key": "TZ", "value": "${TZ}" },
        { "key": "PORT", "value": "8000" },
        { "key": "REDIS_URL", "value": "redis://cache" },
        { "key": "DATABASE_URL", "value": "postgresql://panel:panel@db/panel" },
        { "key": "DATABASE_MIGRATE", "value": "true" },
        { "key": "APP_DEBUG", "value": "false" },
        { "key": "APP_LOG_DIRECTORY", "value": "/var/log/calagopus" },
        { "key": "APP_PRIMARY", "value": "true" },
        { "key": "APP_ENABLE_WINGS_PROXY", "value": "true" },
        { "key": "APP_ENCRYPTION_KEY", "value": "${CALAGOPUS_ENCRYPTION_KEY}" },
        { "key": "APP_USE_DECRYPTION_CACHE", "value": "true" },
        { "key": "APP_USE_INTERNAL_CACHE", "value": "true" }
      ],
      "dns": ["1.1.1.1", "8.8.8.8", "9.9.9.9"],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/calagopus", "containerPath": "/var/lib/calagopus" },
        { "hostPath": "${APP_DATA_DIR}/data/logs", "containerPath": "/var/log/calagopus" }
      ],
      "dependsOn": {
        "db": { "condition": "service_healthy" },
        "cache": { "condition": "service_started" }
      }
    },
    {
      "name": "db",
      "image": "ghcr.io/calagopus/pgautoupgrade:18-alpine",
      "restart": "unless-stopped",
      "healthCheck": {
        "test": "pg_isready -h 127.0.0.1 -U panel -d panel",
        "interval": "5s",
        "timeout": "5s",
        "retries": 60
      },
      "environment": [
        { "key": "TZ", "value": "${TZ}" },
        { "key": "POSTGRES_USER", "value": "panel" },
        { "key": "POSTGRES_PASSWORD", "value": "panel" },
        { "key": "POSTGRES_DB", "value": "panel" },
        { "key": "PGDATA", "value": "/data" }
      ],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/postgres", "containerPath": "/data" }
      ]
    },
    {
      "name": "cache",
      "image": "ghcr.io/calagopus/valkey:latest",
      "restart": "unless-stopped",
      "command": "--protected-mode no --save 60 1",
      "environment": [
        { "key": "TZ", "value": "${TZ}" }
      ],
      "volumes": [
        { "hostPath": "${APP_DATA_DIR}/data/cache", "containerPath": "/data" }
      ]
    }
  ]
}
